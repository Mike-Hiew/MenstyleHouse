# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menstylehouse?schema=public"
# `schema.prisma` khai `directUrl` cho migration — nó phải đi thẳng vào Postgres,
# không qua pooler. Máy dev và máy chủ một-container không có pooler nên đặt
# **đúng bằng** DATABASE_URL. Thiếu biến này thì `prisma migrate` dừng với P1012.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/menstylehouse?schema=public"

# Auth (M2)
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Để trống là Auth.js từ chối khởi động — cố ý, hơn là chạy với một khoá ai cũng biết.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Gửi email (M6.9)
# console = ghi ra log, KHÔNG gửi đi đâu. Đổi sang "resend" khi đã có khoá.
MAIL_PROVIDER="console"
MAIL_FROM="Men Style House <no-reply@menstylehouse.vn>"
RESEND_API_KEY=""
# Địa chỉ gốc để dựng link tuyệt đối trong mail (mail không có "trang hiện tại").
APP_URL="http://localhost:3000"

# Cron dọn đơn trả trước quá hạn (M5). Không đặt thì route đóng hẳn.
CRON_SECRET=""

# VNPay sandbox (M5) — chưa bật, đợi tài khoản cổng thanh toán
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/thanh-toan/vnpay/ket-qua"

# GHN (M7)
GHN_TOKEN=""
GHN_SHOP_ID=""

# Số proxy tin cậy đứng trước app — quyết định cách đọc IP khách cho rate limit.
#   0 (mặc định) = KHÔNG tin `X-Forwarded-For`. Mọi khách chung một bộ đếm.
#   1            = có đúng một reverse proxy (Caddy/nginx) nối IP thật vào cuối.
#   2            = Cloudflare rồi mới tới reverse proxy của mình.
# Khai thiếu thì cùng lắm là chặn nhầm; khai thừa là mở lại đúng lỗ đã vá, vì
# phần khách tự bịa lại rơi đúng vào vị trí được đọc.
TRUSTED_PROXY_HOPS="0"

# Header do lớp biên GHI ĐÈ, tin được hơn X-Forwarded-For. Sau Cloudflare thì
# đặt "cf-connecting-ip". Chỉ đúng khi app không vào thẳng được từ Internet —
# vào thẳng được thì header này cũng bịa được như mọi header khác.
TRUSTED_IP_HEADER=""

# Rate limit dùng chung giữa nhiều instance. Để trống thì đếm trong RAM của
# từng tiến trình — chỉ đúng khi chạy một instance duy nhất.
REDIS_URL=""
