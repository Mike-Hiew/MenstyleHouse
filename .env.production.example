# Mẫu cấu hình cho máy chủ. Chép thành `.env.production` rồi điền.
#
#   cp .env.production.example .env.production
#
# Sinh bí mật (chạy từng dòng, dán kết quả vào):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # AUTH_SECRET
#   node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"      # POSTGRES_PASSWORD
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"      # CRON_SECRET
#
# File thật KHÔNG được commit — nó đã nằm trong .gitignore. Đặt chmod 600.

# ─── Cơ sở dữ liệu ───────────────────────────────────────────────────────────
# `postgres` là tên service trong docker-compose.yml, không phải localhost.
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://postgres:MAT_KHAU@postgres:5432/menstylehouse?schema=public"
# Chỉ cần khi `schema.prisma` khai `directUrl` (nhánh chạy Vercel + Neon dùng
# pooler thì có). Nhánh này nối thẳng vào Postgres cùng máy nên bỏ trống.
DIRECT_URL="

# ─── Tên miền và phiên đăng nhập ─────────────────────────────────────────────
# Caddy xin chứng chỉ cho DOMAIN. Ba dòng này phải cùng trỏ về một địa chỉ:
# sai một chỗ là link trong mail đặt lại mật khẩu dẫn về nơi khác.
DOMAIN="menstylehouse.vn"
AUTH_URL="https://menstylehouse.vn"
APP_URL="https://menstylehouse.vn"
AUTH_SECRET=""

# ─── Đọc IP khách ────────────────────────────────────────────────────────────
# 1 = đứng sau đúng một Caddy. Đổi thành 2 nếu bật thêm Cloudflare ở chế độ
# proxy, và khi đó đặt TRUSTED_IP_HEADER="cf-connecting-ip".
# Xem `docs/ARCHITECTURE.md` — khai sai là mở lại lỗ đã vá.
TRUSTED_PROXY_HOPS="1"
TRUSTED_IP_HEADER=""

# ─── Gửi mail ────────────────────────────────────────────────────────────────
# "console" = ghi ra log, KHÔNG gửi đi đâu. Link đặt lại mật khẩu vẫn đọc được
# bằng `docker compose logs app`. Đổi sang "resend" khi đã xác thực domain.
MAIL_PROVIDER="console"
MAIL_FROM="Men Style House <no-reply@menstylehouse.vn>"
RESEND_API_KEY=""

# ─── Cron ────────────────────────────────────────────────────────────────────
# Để trống thì route dọn đơn quá hạn đóng hẳn.
CRON_SECRET=""

# ─── Chỉ cần khi chạy từ hai bản sao trở lên ─────────────────────────────────
# Để trống thì rate limit đếm trong RAM — đúng khi chỉ có một tiến trình app.
REDIS_URL=""

# ─── Cổng thanh toán và vận chuyển (chưa dùng) ───────────────────────────────
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="https://menstylehouse.vn/thanh-toan/vnpay/ket-qua"
GHN_TOKEN=""
GHN_SHOP_ID=""
